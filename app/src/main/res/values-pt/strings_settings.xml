    <!-- Onboarding -->
    <string name="onboarding_p1_title">Boas-vindas ao Earnd</string>
    <string name="onboarding_p1_body">Escolher as apps que distraem. O Earnd mantém-nas fechadas até ser feito um pouco do que realmente importa.</string>
    <string name="onboarding_p2_title">Ganhar tempo</string>
    <string name="onboarding_p2_body">Cada registo de hábito e cada tarefa concluída acrescenta minutos ao banco. Iniciar uma sessão a qualquer momento abre as apps até ela terminar.</string>
    <string name="onboarding_p3_title">Como funciona: hábitos</string>
    <string name="onboarding_p3_body">Adicionar alguns hábitos e escolher quando acontecem. Registar com um toque, ou com uma foto como prova. Cada registo ganha minutos.</string>
    <string name="onboarding_p4_title">Como funciona: tarefas</string>
    <string name="onboarding_p4_body">As tarefas servem para coisas pontuais. Nunca bloqueiam nada, mas uma tarefa pode ter uma recompensa que acrescenta minutos quando é concluída.</string>
    <string name="onboarding_p5_title">Como funciona: desbloqueio</string>
    <string name="onboarding_p5_body">Gastar minutos guardados abre as apps de lazer por algum tempo; concluir tudo o que está planeado para hoje também as abre. Os minutos guardados são repostos por dia ou por semana.</string>
    <string name="onboarding_p6_title">Suave por conceção</string>
    <string name="onboarding_p6_body">Dias sem nada planeado nunca bloqueiam nada. Telefone, mensagens, mapas e definições ficam sempre abertos. Os dados ficam neste telemóvel.</string>
    <string name="onboarding_permissions_title">Permissões</string>
    <string name="onboarding_permissions_later">Estas opções podem ser alteradas mais tarde nas Definições.</string>
    <string name="onboarding_skip">Saltar</string>
    <string name="onboarding_next">Seguinte</string>
    <string name="onboarding_get_started">Começar</string>
    <string name="onboarding_keep_title">Manter o Earnd ativo</string>
    <string name="onboarding_restricted_title">Se o serviço de bloqueio estiver a cinzento</string>
    <string name="onboarding_restricted_body">O Android pode marcá-lo como definição restrita. Abrir Informações da app, tocar no menu de três pontos no canto superior direito, escolher Permitir definições restritas e voltar a ativar o serviço de bloqueio.</string>
    <string name="onboarding_open_app_info">Abrir Informações da app</string>
    <string name="onboarding_oem_title">Em telemóveis %1$s</string>
    <string name="onboarding_generic_battery">Se os lembretes pararem ou o bloqueio se desligar, verificar se a utilização da bateria do Earnd está definida como Sem restrições.</string>
    <string name="onboarding_back">Voltar</string>

