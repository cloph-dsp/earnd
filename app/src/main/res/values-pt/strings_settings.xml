    <string name="onboarding_perm_a11y_title">Serviço de bloqueio</string>
    <string name="onboarding_perm_a11y_why">Permite ao Earnd detetar a abertura de uma app ou site de lazer e mostrar o ecrã de bloqueio. Nada é gravado nem enviado para lado nenhum.</string>
    <string name="onboarding_perm_usage_title">Acesso ao uso</string>
    <string name="onboarding_perm_usage_why">Alternativa opcional para detetar a app em primeiro plano. O Earnd funciona sem ela.</string>
    <string name="onboarding_perm_notif_title">Notificações</string>
    <string name="onboarding_perm_notif_why">Lembretes e a lista única do que ainda está pendente.</string>
    <string name="onboarding_perm_exact_title">Alarmes exatos</string>
    <string name="onboarding_perm_exact_why">Para os lembretes tocarem à hora certa, em vez de quando o sistema calhar.</string>
    <string name="onboarding_perm_battery_title">Executar em segundo plano</string>
    <string name="onboarding_perm_battery_why">Impede o sistema de adormecer o Earnd, o que silenciaria alarmes e bloqueio.</string>
