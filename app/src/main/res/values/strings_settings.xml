    <!-- Onboarding -->
    <string name="onboarding_p1_title">Welcome to Earnd</string>
    <string name="onboarding_p1_body">"Pick the apps that pull you away. Earnd keeps them closed until you've done a little of what matters to you."</string>
    <string name="onboarding_p2_title">Earn your time</string>
    <string name="onboarding_p2_body">Each habit check-in and finished task adds minutes to your bank. Start a session whenever you like, and the apps open until it ends.</string>
    <string name="onboarding_p3_title">How it works: habits</string>
    <string name="onboarding_p3_body">Add a few habits and pick when they happen. Check in with a tap, or with a photo if you want proof. Each check-in earns minutes.</string>
    <string name="onboarding_p4_title">How it works: tasks</string>
    <string name="onboarding_p4_body">Tasks are for one-off things. They never lock anything, but a task can carry a reward that adds minutes when you finish it.</string>
    <string name="onboarding_p5_title">How it works: unlocking</string>
    <string name="onboarding_p5_body">Spend saved minutes to open your leisure apps for a while, or finish everything planned today and they open on their own. Saved minutes reset each day or week.</string>
    <string name="onboarding_p6_title">Gentle by design</string>
    <string name="onboarding_p6_body">Days with nothing planned never lock anything. Phone, messages, maps and settings always stay open. Your data stays on this phone.</string>
    <string name="onboarding_permissions_title">Permissions</string>
    <string name="onboarding_permissions_later">You can change these later in Settings.</string>
    <string name="onboarding_skip">Skip</string>
    <string name="onboarding_next">Next</string>
    <string name="onboarding_get_started">Get started</string>
    <string name="onboarding_keep_title">Keep Earnd running</string>
    <string name="onboarding_restricted_title">If the blocking service is greyed out</string>
    <string name="onboarding_restricted_body">Android may mark it as a restricted setting. Open App info, tap the three-dot menu at the top right, choose Allow restricted settings, then turn the blocking service on again.</string>
    <string name="onboarding_open_app_info">Open App info</string>
    <string name="onboarding_oem_title">On %1$s phones</string>
    <string name="onboarding_generic_battery">If reminders stop or blocking turns itself off, check that battery use for Earnd is set to Unrestricted.</string>
    <string name="onboarding_back">Back</string>

    <!-- Permission cards -->
    <string name="onboarding_perm_a11y_title">Blocking service</string>
    <string name="onboarding_perm_a11y_why">Lets Earnd notice when a leisure app or site opens and show the lock screen. Nothing is recorded or sent anywhere.</string>
    <string name="onboarding_perm_usage_title">Usage access</string>
    <string name="onboarding_perm_usage_why">Optional backup for spotting the app in front. Earnd works without it.</string>
    <string name="onboarding_perm_notif_title">Notifications</string>
    <string name="onboarding_perm_notif_why">Reminders and the single list of things still waiting for you.</string>
    <string name="onboarding_perm_exact_title">Exact alarms</string>
    <string name="onboarding_perm_exact_why">So reminders ring on time instead of whenever the system gets round to it.</string>
    <string name="onboarding_perm_battery_title">Run in the background</string>
    <string name="onboarding_perm_battery_why">Stops the system from putting Earnd to sleep, which would silence alarms and blocking.</string>
    <string name="onboarding_perm_fullscreen_title">Full-screen alarms</string>
    <string name="onboarding_perm_fullscreen_why">Lets an alarm you chose to be loud fill the screen, even when the phone is locked.</string>
    <string name="onboarding_perm_optional">%1$s (optional)</string>
    <string name="onboarding_perm_on">On</string>
    <string name="onboarding_perm_off">Off</string>
    <string name="onboarding_perm_allow">Allow</string>

    <!-- Phone-maker guidance -->
    <string name="onboarding_oem_battery_unrestricted">Settings &gt; Apps &gt; Earnd &gt; Battery: Unrestricted.</string>
    <string name="onboarding_oem_xiaomi_1">Settings &gt; Apps &gt; Manage apps &gt; Earnd &gt; Autostart: on.</string>
    <string name="onboarding_oem_xiaomi_2">Same page &gt; Battery saver: No restrictions.</string>
    <string name="onboarding_oem_xiaomi_3">"In Recents, pull down on Earnd and tap the lock so it isn't cleared."</string>
    <string name="onboarding_oem_samsung_2">Settings &gt; Battery &gt; Background usage limits: make sure Earnd is not in Sleeping or Deep sleeping apps.</string>
    <string name="onboarding_oem_nothing_2">In Recents, long-press Earnd and lock it.</string>
    <string name="onboarding_oem_oneplus_1">"Settings &gt; Apps &gt; Earnd &gt; Battery: Unrestricted (or Don't optimise)."</string>
    <string name="onboarding_oem_oneplus_2">Same page: allow Auto launch and background activity.</string>
    <string name="onboarding_oem_oneplus_3">"In Recents, lock Earnd so it isn't cleared."</string>
    <string name="onboarding_oem_huawei_1">Settings &gt; Battery &gt; App launch &gt; Earnd: switch to Manage manually and turn on all three options.</string>
