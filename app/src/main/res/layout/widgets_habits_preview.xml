<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121110"
    android:orientation="horizontal"
    android:padding="8dp">
    <LinearLayout style="@style/WidgetsHabitsPreviewCell">
        <TextView style="@style/WidgetsHabitsPreviewCount" android:text="1/3" android:textColor="#FFB000" />
        <TextView style="@style/WidgetsHabitsPreviewName" android:text="Lavar" android:textColor="#E9E4DA" />
    </LinearLayout>
    <LinearLayout style="@style/WidgetsHabitsPreviewCell">
        <TextView style="@style/WidgetsHabitsPreviewCount" android:text="OK" android:textColor="#A39C8F" />
        <TextView style="@style/WidgetsHabitsPreviewName" android:text="Ler" android:textColor="#A39C8F" />
    </LinearLayout>
    <LinearLayout style="@style/WidgetsHabitsPreviewCell">
        <TextView style="@style/WidgetsHabitsPreviewCount" android:text="0/2" android:textColor="#FFB000" />
        <TextView style="@style/WidgetsHabitsPreviewName" android:text="Treino" android:textColor="#E9E4DA" />
    </LinearLayout>
    <LinearLayout style="@style/WidgetsHabitsPreviewCell">
        <TextView style="@style/WidgetsHabitsPreviewCount" android:text="2/4" android:textColor="#FFB000" />
        <TextView style="@style/WidgetsHabitsPreviewName" android:text="Agua" android:textColor="#E9E4DA" />
    </LinearLayout>
</LinearLayout>
