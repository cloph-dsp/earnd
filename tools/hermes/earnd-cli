#!/usr/bin/env bash
# earnd-cli - talk to the Earnd app on an Android phone over adb.
# SPDX-License-Identifier: GPL-3.0-or-later
#
# Usage: earnd-cli <command> [key=value ...]
#   earnd-cli status
#   earnd-cli tasks.create title="Call the bank" due=tomorrow time=09:30 priority=high
#   earnd-cli habits.checkin id=3
#   earnd-cli habits.create name="Read" minutes=10 reminders="08:00,21:00" remind_days="mon,tue"
#   earnd-cli rules.block_app pkg=com.instagram.android
#   earnd-cli rules.block_site domain=reddit.com
#   earnd-cli settings.tighten unlockCapMin=30
#   earnd-cli sound.push ~/sounds/gong.mp3 [name]   (then: habits.update id=3 sound=custom:gong.mp3)
#   earnd-cli sounds.list
#
# List values are comma-separated in one argument (reminders="08:00,14:00", days="mon,tue").
#
# Free-text values (title, notes, name, unit, message, label) are base64-encoded automatically.
# Output: one JSON object on stdout. Exit code 0 when "ok":true, 1 otherwise, 2 on transport errors.
#
# Environment:
#   EARND_ADB_TARGET  host:port of the phone's adb (wireless debugging), e.g. 100.101.102.103:5555.
#                     If unset, the single USB/attached device is used.
#   ADB               adb binary (default: adb)
#   EARND_PACKAGE     application id (default: com.earnd.app)
#   EARND_DRY_RUN=1   print the device shell command instead of running it (for tests)

set -u

ADB="${ADB:-adb}"
PKG="${EARND_PACKAGE:-com.earnd.app}"
TEXT_KEYS=" title notes name unit message label "

die() { printf '{"ok":false,"error":"%s","message":"%s"}\n' "$1" "$2"; exit 2; }

usage() {
  sed -n '2,26p' "$0" | sed 's/^# \{0,1\}//'
  exit 0
}

[ $# -ge 1 ] || usage
case "$1" in -h|--help|help-cli) usage ;; esac

cmd="$1"; shift
# Command names are lowercase words joined by one dot (e.g. tasks.list); anything else is refused
# before it reaches the phone.
printf '%s' "$cmd" | grep -Eqx '[a-z][a-z0-9_]{0,23}([.][a-z][a-z0-9_]{0,23})?' \
  || die "bad_command" "bad command name"
case "$PKG" in *[!A-Za-z0-9_.]*|"") die "bad_args" "bad EARND_PACKAGE" ;; esac

if [ "${EARND_DRY_RUN:-}" != "1" ]; then
  command -v "$ADB" >/dev/null 2>&1 || die "no_adb" "adb not found in PATH"
fi

adb_args=()
if [ -n "${EARND_ADB_TARGET:-}" ] && [ "${EARND_DRY_RUN:-}" != "1" ]; then
  # Connect if not already attached; harmless when already connected.
  if ! "$ADB" devices | awk 'NR>1 && $2=="device" {print $1}' | grep -qxF "$EARND_ADB_TARGET"; then
    "$ADB" connect "$EARND_ADB_TARGET" >/dev/null 2>&1
    "$ADB" -s "$EARND_ADB_TARGET" wait-for-device 2>/dev/null &
    wpid=$!
    ( sleep 10; kill "$wpid" 2>/dev/null ) &
    wait "$wpid" 2>/dev/null
  fi
  adb_args=(-s "$EARND_ADB_TARGET")
fi

b64() { printf '%s' "$1" | base64 | tr -d '\n'; }

# Quote a value for the device shell: adb shell joins its args into ONE command line that the
# phone's sh parses again, so every user value is single-quoted, with each ' written as '\''.
shq() { printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"; }

# sound.push <local file> [name]: copy an audio file into the app's media dir (readable by the app
# without permissions) and print its key. Local, so it does not go through the remote receiver.
if [ "$cmd" = "sound.push" ]; then
  [ $# -ge 1 ] && [ $# -le 2 ] || die "bad_args" "usage: sound.push <local file> [name]"
  src="$1"
  name="${2:-$(basename "$src")}"
  name="$(basename "$name" | tr -c 'A-Za-z0-9._
-' '_')"
  name="${name#.}"; name="${name#_}"
  [ -n "$name" ] || die "bad_args" "bad sound name"
  ext="$(printf '%s' "${name##*.}" | tr 'A-Z' 'a-z')"
  [ "$ext" = "${name%.*}" ] && ext=""
  if [ -z "$ext" ]; then ext="$(printf '%s' "${src##*.}" | tr 'A-Z' 'a-z')"; name="$name.$ext"; fi
  case "$ext" in mp3|ogg|wav|m4a) ;; *) die "bad_args" "only .mp3 .ogg .wav .m4a allowed" ;; esac
  [ ${#name} -le 100 ] || die "bad_args" "name too long"
  dest="/sdcard/Android/media/$PKG/sounds"
  if [ "${EARND_DRY_RUN:-}" = "1" ]; then
    printf '%s
' "mkdir -p $dest" "push $src $dest/$name"
    exit 0
  fi
  [ -f "$src" ] || die "bad_args" "file not found"
  "$ADB" "${adb_args[@]}" shell "mkdir -p $dest" >/dev/null 2>&1 || die "adb_failed" "mkdir failed"
  out="$("$ADB" "${adb_args[@]}" push "$src" "$dest/$name" 2>&1)"     || die "adb_failed" "$(printf '%s' "$out" | tr -d '"
' | head -c 200)"
  printf '{"ok":true,"key":"custom:%s"}
' "$name"
  exit 0
fi

extras="--es cmd $(shq "$cmd")"
for kv in "$@"; do
  case "$kv" in *=*) ;; *) die "bad_args" "expected key=value" ;; esac
  key="${kv%%=*}"; val="${kv#*=}"
  case "$key" in *[!A-Za-z0-9_]*|"") die "bad_args" "bad key: $key" ;; esac
  case "$TEXT_KEYS" in
    *" $key "*) extras="$extras --es ${key}_b64 $(b64 "$val")" ;;
    *) extras="$extras --es $key $(shq "$val")" ;;
  esac
done

remote_cmd="am broadcast -n $PKG/.remote.RemoteReceiver -a $PKG.REMOTE $extras"
if [ "${EARND_DRY_RUN:-}" = "1" ]; then
  printf '%s\n' "$remote_cmd"
  exit 0
fi

out="$("$ADB" "${adb_args[@]}" shell "$remote_cmd" 2>&1)" \
  || die "adb_failed" "$(printf '%s' "$out" | tr -d '"\r\n' | head -c 200)"

# Expected: Broadcast completed: result=0, data="{...}"
line="$(printf '%s\n' "$out" | tr -d '\r' | grep -m1 '^Broadcast completed:')"
case "$line" in
  *'data="'*) ;;
  *) die "no_reply" "$(printf '%s' "$out" | tr -d '"\r\n' | head -c 200)" ;;
esac
json="${line#*data=\"}"
json="${json%\"}"

printf '%s\n' "$json"
case "$json" in *'"ok":true'*) exit 0 ;; *) exit 1 ;; esac
