<?xml version="1.0" encoding="utf-8"?>
<!-- Remote management fragment. Merge the <receiver> into the base manifest's <application>.
     android.permission.DUMP is held only by the shell (adb) and the system, so ordinary apps
     cannot send to this receiver even though it is exported. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <receiver
            android:name=".remote.RemoteReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.earnd.app.REMOTE" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
