<?xml version="1.0" encoding="utf-8"?>
<!-- UI fragment: permissions the onboarding asks for, launcher-app visibility for the picker, deep links. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Leisure app picker lists launchable apps (Android 11+ package visibility). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application>
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <!-- earnd://task?id=, earnd://add-task, earnd://checkin?habitId= -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="earnd" android:host="task" />
                <data android:scheme="earnd" android:host="add-task" />
                <data android:scheme="earnd" android:host="checkin" />
            </intent-filter>
        </activity>
    </application>
</manifest>
